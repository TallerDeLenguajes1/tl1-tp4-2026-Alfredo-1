### C ###
# Requisitos previos
*.d

# Archivos objeto
*.o
*.ko
*.obj
*.duende

# Salida del enlazador
*.seda
*.mapa
*.exp

# Encabezados precompilados
*.gch
*.pch

# Bibliotecas
*.lib
*.a
*.la
*.lo

# Objetos compartidos (incluidas las DLL de Windows)
*.dll
*.entonces
*.entonces.*
*.dylib

# Archivos ejecutables
*.exe
*.afuera
*.app
*.i*86
*.x86_64
*.maleficio

# Archivos de depuración
*.dSYM/
*.su
*.idb
*.pdb

# Resultados de la compilación del módulo del kernel
*.mod*
*.cmd
.tmp_versions/
módulos.orden
Módulo.symvers
Archivo Mkfile.old
dkms.conf

### Código de Visual Studio ###
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Historial local para Visual Studio Code
.historia/

# Extensiones de Visual Studio Code creadas
*.vsix

### Parche de VisualStudioCode ###
# Ignorar todo el historial local de archivos
.historia
iónido

